@page "/"
@using BlazorClient.Features.Doctors
@using BlazorClient.Infrastructure.Interfaces
@rendermode InteractiveServer

@inject IDoctorService DoctorService

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

@code {
    private string searchTerm = string.Empty;
    private string selectedSpecialization = string.Empty;
    private int currentPage = 1;

    private bool isLoading = false;

    // private DoctorSearchResultDto? searchResult;
    private List<string> specializations = new();
    private List<DoctorDto> _doctorDtos = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSpecializations();
    }

    private async Task LoadSpecializations()
    {
        try
        {
        Console.WriteLine(_doctorDtos);
            
            var allDoctors = await DoctorService.GetAllDoctorsAsync();
            _doctorDtos = allDoctors.ToList();
            Console.WriteLine(_doctorDtos);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            // Snackbar.Add($"Error loading specializations: {ex.Message}", Severity.Error);
        }
    }

}